# 上传服务开发环境配置模板
server:
  host: "0.0.0.0"
  port: 8082
  mode: "debug"  # debug, release, test
  read_timeout: 60s
  write_timeout: 60s

database:
  host: "127.0.0.1"
  port: 3309  # 使用主MySQL容器端口
  username: "root"
  password: "YOUR_DATABASE_PASSWORD"
  database: "upload_service"
  charset: "utf8mb4"
  parse_time: true
  loc: "Local"
  max_idle_conns: 10
  max_open_conns: 100
  conn_max_lifetime: 3600s

redis:
  host: "localhost"
  port: 6379
  password: "YOUR_REDIS_PASSWORD"
  db: 1  # 使用不同的db避免冲突
  pool_size: 10
  min_idle_conns: 5
  dial_timeout: 5s
  read_timeout: 3s
  write_timeout: 3s

jwt:
  secret: "YOUR_JWT_SECRET_KEY"
  expire_time: 24h
  refresh_expire_time: 168h  # 7 days

log:
  level: "debug"  # debug, info, warn, error
  format: "json"  # json, text
  output: "stdout"  # stdout, file
  filename: "logs/upload-service.log"
  max_size: 100  # MB
  max_backups: 7
  max_age: 30  # days
  compress: true

minio:
  endpoint: "localhost:9001"
  access_key_id: "YOUR_MINIO_ACCESS_KEY"
  secret_access_key: "YOUR_MINIO_SECRET_KEY"
  use_ssl: false
  bucket_name: "video-storage"

# etcd配置
etcd:
  endpoints:
    - "YOUR_ETCD_ENDPOINT"
  dial_timeout: 5s
  request_timeout: 3s
  username: "YOUR_ETCD_USERNAME"
  password: "YOUR_ETCD_PASSWORD"

# gRPC客户端配置
grpc:
  timeout: 30s
  max_recv_msg_size: 4194304  # 4MB
  max_send_msg_size: 4194304  # 4MB
  retry_times: 3

# 服务注册配置
service_registry:
  service_name: "upload-service"
  service_id: "upload-service-1"
  ttl: 30s
  refresh_interval: 10s

# 依赖服务配置
dependencies:
  user_service:
    service_name: "user-service"
    timeout: 30s

# 上传服务特定配置
upload:
  max_file_size: 100MB  # 最大文件大小
  allowed_types:
    - "image/jpeg"
    - "image/png"
    - "image/gif"
    - "video/mp4"
    - "video/avi"
    - "video/mov"
    - "application/pdf"
    - "text/plain"
  upload_path: "./uploads"  # 本地临时存储路径
  chunk_size: 1MB  # 分片上传大小
  
# 服务发现配置
service_discovery:
  enabled: false
  consul:
    address: "localhost:8500"
    service_name: "upload-service"
    health_check_interval: "10s"
    
# 监控配置
monitoring:
  metrics:
    enabled: true
    path: "/metrics"
  tracing:
    enabled: false
    jaeger_endpoint: "http://localhost:14268/api/traces"