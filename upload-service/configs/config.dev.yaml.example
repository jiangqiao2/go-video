# 上传服务开发环境配置模板
server:
  host: "0.0.0.0"
  port: 8082
  mode: "debug"  # debug, release, test
  read_timeout: 60s
  write_timeout: 60s

database:
  host: "127.0.0.1"
  port: 3309  # 使用主MySQL容器端口
  username: "root"
  password: "YOUR_DATABASE_PASSWORD"
  database: "upload_service"
  charset: "utf8mb4"
  parse_time: true
  loc: "Local"
  max_idle_conns: 10
  max_open_conns: 100
  conn_max_lifetime: 3600s

redis:
  host: "localhost"
  port: 6379
  password: "YOUR_REDIS_PASSWORD"
  db: 1  # 使用不同的db避免冲突
  pool_size: 10
  min_idle_conns: 5
  dial_timeout: 5s
  read_timeout: 3s
  write_timeout: 3s
  enable_tls: false

jwt:
  secret: "YOUR_JWT_SECRET_KEY"
  issuer: "go-video"
  rsa_private_key_path: "./certs/jwtRS256.key"
  rsa_public_key_path: "./certs/jwtRS256.key.pub"
  expire_time: 24h
  refresh_expire_time: 168h

log:
  level: "debug"  # debug, info, warn, error
  format: "json"  # json, text
  output: "stdout"  # stdout, file
  filename: "logs/upload-service.log"
  max_size: 100  # MB
  max_backups: 7
  max_age: 30  # days
  compress: true



# etcd配置
etcd:
  endpoints: []          # 线上如需etcd可填入地址，空即关闭
  dial_timeout: 5s
  request_timeout: 3s
  username: ""
  password: ""

# gRPC客户端配置
grpc:
  timeout: 30s
  max_recv_msg_size: 4194304  # 4MB
  max_send_msg_size: 4194304  # 4MB
  retry_times: 3

grpc_server:
  host: "0.0.0.0"
  port: 9093

grpc_service_registry:
  enabled: false
  service_name: "upload-service"
  service_id: "upload-service-grpc-1"
  register_host: "127.0.0.1"
  ttl: 30s
  refresh_interval: 10s

# 服务注册配置
service_registry:
  enabled: false
  service_name: "upload-service"
  service_id: "upload-service-1"
  ttl: 30s
  refresh_interval: 10s

# 依赖服务配置
dependencies:
  user_service:
    address: ""   # 留空则使用 host:port
    host: "host.docker.internal"
    service_name: "user-service"
    timeout: 30s
  transcode_service:
    address: ""   # 留空则使用 host:port
    host: "localhost"
    service_name: "transcode-service"
    timeout: 30s

# 上传服务特定配置
upload:
  max_file_size: 100MB  # 最大文件大小
  allowed_types:
    - "image/jpeg"
    - "image/png"
    - "image/gif"
    - "video/mp4"
    - "video/avi"
    - "video/mov"
    - "application/pdf"
    - "text/plain"
  upload_path: "./uploads"  # 本地临时存储路径
  chunk_size: 1MB  # 分片上传大小
  
# 服务发现配置
service_discovery:
  enabled: false
  consul:
    address: "localhost:8500"
    service_name: "upload-service"
    health_check_interval: "10s"
    
# 监控配置
monitoring:
  metrics:
    enabled: true
    path: "/metrics"
  tracing:
    enabled: false
    jaeger_endpoint: "http://localhost:14268/api/traces"

# 对外访问配置
public:
  storage_base: "http://localhost:8000"
