_format_version: "3.0"
_transform: true

services:
  - name: upload-service
    protocol: http
    host: upload-upstream
    routes:
      - name: upload-route
        paths:
          - /api/upload/v1/open
        strip_path: false
      - name: upload-inner-route
        paths:
          - /api/upload/v1/inner
        strip_path: false

  - name: user-service
    protocol: http
    host: user-upstream
    routes:
      - name: user-route
        paths:
          - /api/user/v1/open/users
        strip_path: false
      - name: user-inner-route
        paths:
          - /api/user/v1/inner
        strip_path: false

  - name: rustfs
    protocol: http
    host: rustfs-upstream
    routes:
      - name: rustfs-route
        paths:
          - /storage
        strip_path: true
        methods:
          - GET
          - HEAD
          - PUT
          - DELETE
          - OPTIONS

  - name: video-service
    protocol: http
    host: video-upstream
    routes:
      - name: video-open-route
        paths:
          - /api/video/v1/open
        strip_path: false
      - name: video-inner-route
        paths:
          - /api/video/v1/inner
        strip_path: false

upstreams:
  - name: upload-upstream
    algorithm: round-robin
    healthchecks:
      passive:
        type: http
        healthy:
          successes: 1
          http_statuses:
            - 200
            - 201
            - 202
            - 204
            - 304
        unhealthy:
          http_failures: 5
          tcp_failures: 2
          timeouts: 2
          http_statuses:
            - 429
            - 500
            - 503
    targets:
      - target: $UPLOAD_TARGET
        weight: 100

  - name: user-upstream
    algorithm: round-robin
    healthchecks:
      passive:
        type: http
        healthy:
          successes: 1
          http_statuses:
            - 200
            - 201
            - 202
            - 204
            - 304
        unhealthy:
          http_failures: 5
          tcp_failures: 2
          timeouts: 2
          http_statuses:
            - 429
            - 500
            - 503
    targets:
      - target: $USER_TARGET
        weight: 100

  - name: rustfs-upstream
    algorithm: round-robin
    targets:
      - target: ${RUSTFS_TARGET}
        weight: 100

  - name: video-upstream
    algorithm: round-robin
    healthchecks:
      passive:
        type: http
        healthy:
          successes: 1
          http_statuses:
            - 200
            - 201
            - 202
            - 204
            - 304
        unhealthy:
          http_failures: 5
          tcp_failures: 2
          timeouts: 2
          http_statuses:
            - 429
            - 500
            - 503
    targets:
      - target: $VIDEO_TARGET
        weight: 100

plugins:
  - name: prometheus
  - name: request-id
    config:
      header_name: X-Request-ID
      echo_downstream: true
  - name: cors
    config:
      origins:
        - "*"
      methods:
        - GET
        - POST
        - PUT
        - DELETE
        - OPTIONS
        - PATCH
      headers:
        - Origin
        - Content-Type
        - Accept
        - Authorization
        - X-Requested-With
        - X-User-UUID
        - X-Access-Token
      exposed_headers:
        - Authorization
      credentials: false
      max_age: 3600
      preflight_continue: false
  - name: request-size-limiting
    service: upload-service
    config:
      allowed_payload_size: 64
      size_unit: megabytes
  - name: rate-limiting
    service: upload-service
    config:
      second: 20
      minute: 120
      policy: local
  - name: jwt
    route: user-inner-route
    config:
      key_claim_name: iss
      claims_to_verify:
        - exp
      run_on_preflight: false
      algorithm: RS256
  - name: jwt
    route: upload-inner-route
    config:
      key_claim_name: iss
      claims_to_verify:
        - exp
      run_on_preflight: false
      algorithm: RS256
  - name: jwt
    route: video-inner-route
    config:
      key_claim_name: iss
      claims_to_verify:
        - exp
      run_on_preflight: false
      algorithm: RS256
  - name: request-transformer-advanced
    route: user-inner-route
    config:
      template: true
      remove:
        headers: ["X-User-UUID", "X-Request-ID", "Authorization", "X-Access-Token"]
      add:
        headers:
          - "X-User-UUID:{{jwt_claim_user_uuid}}"
      replace:
        headers:
          - "X-Request-ID:{{request_id}}"
  - name: request-transformer-advanced
    route: upload-inner-route
    config:
      template: true
      remove:
        headers: ["X-User-UUID", "X-Request-ID", "Authorization", "X-Access-Token"]
      add:
        headers:
          - "X-User-UUID:{{jwt_claim_user_uuid}}"
      replace:
        headers:
          - "X-Request-ID:{{request_id}}"
  - name: request-transformer-advanced
    route: video-inner-route
    config:
      template: true
      remove:
        headers: ["X-User-UUID", "X-Request-ID", "Authorization", "X-Access-Token"]
      add:
        headers:
          - "X-User-UUID:{{jwt_claim_user_uuid}}"
      replace:
        headers:
          - "X-Request-ID:{{request_id}}"

